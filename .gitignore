# Python environments and generated packaging output
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/
*.egg

# Python/test/type-check caches
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Logs and transient runtime/provider state
*.log
logs/
runtime/
state/
.cache/
.aws/
.config/
.local/

# Live access registries and secret-bearing material
bundles/
templates/
bootstrap-token
bootstrap-token.*
*.env
*.env.*
*.credentials
credentials
credentials.*
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
*.kubeconfig

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Only these deliberately fake, reviewed example paths are exempted. Do not
# broadly unignore examples/**: that would also re-include keys or credentials.
!examples/
!examples/host-policy.toml
!examples/bundles/
examples/bundles/*
!examples/bundles/development.toml
!examples/bundles/github-dev.toml
!examples/env/
!examples/env/github-dev.env
!examples/schema/
examples/schema/*
!examples/schema/aws-assume-role.toml
!examples/templates/
examples/templates/*
!examples/templates/github-config.tpl
